# 生产环境配置示例（复制为 .env 或填写到平台环境变量）
NODE_ENV=production
PORT=3000

# SQLite 数据文件所在目录（线上需挂载持久卷）
DATA_DIR=/data

# 站点对外地址，用于校验写请求的 Origin（如 https://fund-dashboard.ap-northeast-1.clawcloudrun.com）
APP_ORIGIN=https://your-app.example.com

# 会话有效期（天）
SESSION_TTL_DAYS=30

# SQLite 日志模式：WAL 性能更好；网络卷不支持共享内存时可改为 DELETE
SQLITE_JOURNAL_MODE=WAL

# 登录失败限流（次数 / 窗口分钟）
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MIN=15
